# Identifiants publics EmailJS (aucune clé privée ici).
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=
PUBLIC_EMAILJS_TEMPLATE_OTP_ID=

# Clé de site publique reCAPTCHA v2 ; clé secrète à configurer uniquement dans EmailJS.
PUBLIC_RECAPTCHA_SITE_KEY=

# Origine publique du site, ex. https://votre-domaine.fr (pas de chemin).
PUBLIC_SITE_URL=
