---
import { translator, type Locale } from "../lib/i18n";
interface Props { lang?: Locale; }
const { lang = "fr" } = Astro.props;
const t = translator(lang);
---
<section class="faq-section" id="fonctionnement" aria-labelledby="service-title">
  <div class="section-heading">
    <div><div class="eyebrow">{t("Assistant téléphonique pour garages")}</div><h2 id="service-title">{t("Qu’est-ce qu’Ansolari ?")}</h2></div>
    <p>{t("Ansolari est un projet d’assistant vocal IA destiné aux garages automobiles. Il vise à accueillir les appels, qualifier les demandes et préparer la prise de rendez-vous selon les règles du garage.")}</p>
  </div>
  <div class="faq-list">
    <article><h3>{t("Quels appels peut-on explorer dans la démonstration ?")}</h3><p>{t("Le parcours présente trois exemples : une révision annuelle, un contrôle technique et un diagnostic de panne. Il illustre la qualification du motif, le choix d’un créneau et un récapitulatif.")}</p></article>
    <article><h3>{t("Comment étudier son utilisation dans votre garage ?")}</h3><p>{t("La démonstration personnalisée de 15 minutes permet d’échanger sur vos prestations, vos horaires, votre installation téléphonique et votre agenda. Les compatibilités et les conditions de mise en place sont à confirmer ensemble.")}</p></article>
    <article><h3>{t("Que peut-on tester sur ce site ?")}</h3><p>{t("Vous pouvez parcourir une simulation textuelle et demander une démonstration par e-mail. La simulation utilise des données fictives ; elle ne passe aucun appel et ne réserve aucun rendez-vous réel.")}</p></article>
  </div>
  <a class="button button-ghost" href="#demo">{t("Explorer la simulation")}</a>
</section>
