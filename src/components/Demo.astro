---
import CallDemo from "./CallDemo";

import { translator, type Locale } from "../lib/i18n";
interface Props { lang?: Locale; }
const { lang = "fr" } = Astro.props;
const t = translator(lang);
---
<section class="demo-section" id="demo">
        <div class="section-heading reveal">
          <div>
            <div class="eyebrow">{t("Démonstration interactive")}</div>
            <h2>{t("Testez le parcours en moins d’une minute.")}</h2>
          </div>
          <p>{t("Incarnez un client qui appelle pendant que l’équipe du garage est occupée.")}</p>
        </div>
<CallDemo lang={lang} client:load />
<noscript><p>{t("Activez JavaScript pour utiliser la simulation interactive.")}</p></noscript>
</section>